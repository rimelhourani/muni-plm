# miniPLM - Configuration d'Environnement

# ========================================
# Backend (Spring Boot)
# ========================================

# Server
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Database
SPRING_DATASOURCE_URL=jdbc:h2:mem:miniplm
SPRING_DATASOURCE_DRIVERCLASSNAME=org.h2.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop

# Pour MySQL (production)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/miniplm
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=password
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters
JWT_EXPIRATION_MS=86400000

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MINIPLM=DEBUG

# ========================================
# Frontend (Angular)
# ========================================

# API URL (development - uses proxy)
ANGULAR_API_URL=/api/v1

# Or for production:
# ANGULAR_API_URL=https://api.miniplm.com/api/v1

# ========================================
# Application
# ========================================

# Environnement
APP_ENV=development
APP_VERSION=1.0.0
APP_NAME=miniPLM

# Cors (pour production)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://miniplm.vercel.app
